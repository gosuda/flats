  "narrative": {
    "northStar": "Operate / Read",
    "overview": "Operate / Read is a quiet document workspace: compact controls frame a spacious reading surface. System typography, restrained green, and thin dividers keep Markdown and collaboration state legible. Editing and reading share one view: editors edit the rendered document in place, and the public read-only view shows the same surface without an editor.",
    "keyCharacteristics": [
      "System typography and a restrained green accent.",
      "Flat surfaces separated by borders and tonal contrast.",
      "Persistent collaboration and save state above the document.",
      "A single centered reading surface with a 16px mobile gutter."
    ],
    "rules": [
      {
        "name": "Restrained Accent",
        "body": "Use green for links, saved state and focus; keep document text neutral.",
        "section": "colors"
      },
      {
        "name": "Single View",
        "body": "Keep the header stable while one document surface consumes the remaining viewport height. There are no view modes: editors edit the rendered document in place.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do retain system fonts and automatic light/dark color-scheme support.",
      "Do keep mobile content gutters at 16px and avatar initials legible.",
      "Do use named controls, visible keyboard focus, and explicit selected states.",
      "Do let the document surface fill the remaining viewport height and scroll as one page, with the footer after the document."
    ],
    "donts": [
      "Don't add decorative shadows or a display font to the document workspace.",
      "Don't communicate saved state through color alone.",
      "Don't reintroduce separate edit, split or preview modes."
    ]
  }
