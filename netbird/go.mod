// The nested module builds against the checkout it lives in.
replace github.com/gosuda/flats => ../

// NetBird's own replace directives. Replaces in a dependency's go.mod do not
// apply to the module that requires it, so they are repeated here. They are
// why NetBird is a separate module: Go rejects go install pkg@version for a
// module whose go.mod has replace directives.
replace golang.zx2c4.com/wireguard => github.com/netbirdio/wireguard-go v0.0.0-20260914123147-8bf8fa968f1a

